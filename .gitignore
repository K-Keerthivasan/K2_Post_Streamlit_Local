# ── Secrets / env ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.tailscale.example

# ── Personal config (your real brands, channels, keys) ─────────
# config.example.yaml is the committed generic template; config.yaml is yours.
config.yaml

# ── Python ─────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node (canvas/codemirror tooling, if any) ──────────────────
node_modules/

# ── App-generated content (not source) ────────────────────────
outputs/
image_cache/
library/
.active_brand
tailscale/state/
*.bak
test_*.png

# ── Editors / OS cruft ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.log
.DS_Store
Thumbs.db

# NOTE: static/fonts/ (bundled Roboto Mono) IS committed — required for
# offline rendering, so it is intentionally NOT ignored.
