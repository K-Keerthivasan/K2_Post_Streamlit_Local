# ── Image sources ──────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_key
UNSPLASH_API_KEY=your_unsplash_key
# Google Programmable Search (optional image source)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_search_engine_id

# ── Agent review → publish (optional) ──────────────────────────
# When you Approve a post in the Review tab, the app POSTs it here.
# Point this at an n8n Webhook node that publishes via Publer/Metricool/etc.
N8N_WEBHOOK_URL=
# Public base URL the webhook receiver can fetch rendered images from
# (e.g. your Tailscale Serve URL). Used to build absolute image links.

# ── Publishing: Instagram + Facebook (Meta Graph API) ──────────────
# Long-lived access token for your Meta app. Needs the scopes:
#   instagram_basic, instagram_content_publish, pages_show_list,
#   pages_read_engagement, pages_manage_posts
# Get a short-lived token from the Graph API Explorer, then run:
#   python meta.py --exchange-token <short-lived-token>
# Account ids (ig_user_id / fb_page_id) live in config.yaml -> meta.accounts.
# Verify the whole setup with:  python meta.py --verify
META_ACCESS_TOKEN=
# App credentials, used to exchange short-lived tokens for long-lived ones.
# A Meta app shows two different pairs and they are NOT interchangeable:
#   META_APP_*      -> App settings > Basic  (the Facebook app id/secret)
#   INSTAGRAM_APP_* -> Instagram > API setup ("Instagram app ID / app secret")
# Facebook-login tokens:  python meta.py --exchange-token <short-lived-token>
# Instagram-login tokens: python meta.py --exchange-ig-token <short-lived-token>
#                         python meta.py --refresh-ig-token <long-lived-token>
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# REQUIRED for Instagram: a public https base URL that serves this app's
# /outputs folder (e.g. a Tailscale Funnel URL). Meta's servers fetch the
# rendered images from there, so localhost can never work.
PUBLIC_BASE_URL=

# Local AI backend.
# Default config.yaml uses Hermes directly through its CLI. You can also switch
# the engine live in the header "Engine" dropdown (Hermes ↔ Ollama) — no restart.
K2_LLM_BASE_URL=hermes://cli
K2_LLM_MODEL=hermes:gpt-5.5
K2_HERMES_COMMAND=hermes
K2_HERMES_TIMEOUT=300
# Ollama (the other built-in backend) defaults to http://localhost:11434/v1.
# Override the per-backend host/model in config.yaml -> llm.backends if needed.

# ── Post data store (optional MySQL) ───────────────────────────
# Set K2_MYSQL_DB (and creds) to manage the generated-post / review queue in
# MySQL — posts are stored in a `posts` table with real DATETIME created/approved
# columns. Leave K2_MYSQL_DB blank to keep using the local JSON queue file.
K2_MYSQL_HOST=localhost
K2_MYSQL_PORT=3306
K2_MYSQL_USER=root
K2_MYSQL_PASSWORD=
K2_MYSQL_DB=
